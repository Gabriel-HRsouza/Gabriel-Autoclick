<Window x:Class="GabrielAutoclick.Views.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gabriel Autoclick"
        Height="104" Width="300"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        Topmost="True"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        WindowStartupLocation="Manual"
        MouseDown="Window_MouseDown">

    <Border BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Background="{StaticResource SidebarBgBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Gabriel Autoclick" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnRestore" Click="BtnRestore_Click" Style="{StaticResource ChromeButton}"
                            Width="36" Height="30" Content="&#xE8A7;" ToolTip="Abrir janela principal"/>
                    <Button x:Name="BtnClose" Click="BtnClose_Click" Style="{StaticResource ChromeCloseButton}"
                            Width="36" Height="30" Content="&#xE8BB;" ToolTip="Fechar modo compacto"/>
                </StackPanel>
            </Grid>

            <!-- Status + toggle -->
            <Grid Grid.Row="1" Margin="14,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource TextMutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtStatus" Text="Desligado" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="16,3,0,0">
                        <TextBlock x:Name="TxtCps" Text="10.0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text=" cliques/s" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <Button x:Name="BtnToggle" Grid.Column="1" Click="BtnToggle_Click"
                        Style="{StaticResource PrimaryButton}" Width="104" Height="36" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TxtBtnIcon" Text="&#xE768;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtBtnLabel" Text="Iniciar"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>

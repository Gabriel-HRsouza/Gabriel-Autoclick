<Window x:Class="GabrielAutoclick.Views.PointPickerOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Selecionar ponto"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        Topmost="True"
        ShowInTaskbar="False"
        WindowState="Maximized"
        Cursor="Cross"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown"
        MouseMove="Window_MouseMove"
        MouseDown="Window_MouseDown">
    <Canvas x:Name="OverlayCanvas">
        <!-- Instructions -->
        <Border Canvas.Left="40" Canvas.Top="32"
                Background="#F21B1F24"
                BorderBrush="#3A414B"
                BorderThickness="1"
                CornerRadius="8"
                Padding="18,12">
            <StackPanel>
                <TextBlock Text="Selecionar ponto" Foreground="#E8EAED" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Text="Clique no local desejado. Esc cancela." Foreground="#A1A7B0" FontSize="12" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Coordinates next to the cursor -->
        <Border x:Name="CoordHud"
                Background="#F21B1F24"
                BorderBrush="#3A414B"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,6"
                Canvas.Left="0" Canvas.Top="0"
                IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="X " Foreground="#A1A7B0" FontSize="12"/>
                <TextBlock x:Name="TxtX" Text="0" Foreground="#E8EAED" FontSize="12" Margin="0,0,10,0"/>
                <TextBlock Text="Y " Foreground="#A1A7B0" FontSize="12"/>
                <TextBlock x:Name="TxtY" Text="0" Foreground="#E8EAED" FontSize="12"/>
            </StackPanel>
        </Border>
    </Canvas>
</Window>

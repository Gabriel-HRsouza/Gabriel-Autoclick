<Window x:Class="GabrielAutoclick.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gabriel Autoclick"
        Height="740" Width="1080"
        MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBgBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        Icon="pack://application:,,,/GabrielAutoclick;component/Assets/icon.ico"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <!-- ======================================================== -->
            <!-- TITLE BAR                                                -->
            <!-- ======================================================== -->
            <Grid Grid.Row="0" Background="{StaticResource SidebarBgBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="pack://application:,,,/GabrielAutoclick;component/Assets/icon.ico"
                           Width="18" Height="18" Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Gabriel Autoclick" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnMiniMode" Click="BtnMiniMode_Click" Style="{StaticResource ChromeButton}"
                            Content="&#xE8A7;" ToolTip="Modo compacto" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Click="BtnMinimize_Click" Style="{StaticResource ChromeButton}"
                            Content="&#xE921;" ToolTip="Minimizar" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="BtnMaximize" Click="BtnMaximize_Click" Style="{StaticResource ChromeButton}"
                            Content="&#xE922;" ToolTip="Maximizar" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Click="BtnClose_Click" Style="{StaticResource ChromeCloseButton}"
                            Content="&#xE8BB;" ToolTip="Fechar" WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>

            <!-- ======================================================== -->
            <!-- BODY                                                     -->
            <!-- ======================================================== -->
            <Grid Grid.Row="1" ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="212"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Background photo + darkening layer -->
                <Image x:Name="ImgWallpaper" Grid.ColumnSpan="2"
                       Source="pack://application:,,,/GabrielAutoclick;component/Assets/background.jpg"
                       Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
                <Rectangle x:Name="RectDarkOverlay" Grid.ColumnSpan="2" Fill="{StaticResource WindowBgBrush}"
                           Opacity="0.80" IsHitTestVisible="False"/>

                <!-- Sidebar -->
                <Border Background="{StaticResource SidebarGlassBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Grid Margin="10,8,10,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <StackPanel>
                                <RadioButton x:Name="TabNavDashboard" Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="Painel" IsChecked="True" Checked="NavTab_Checked"/>
                                <RadioButton x:Name="TabNavAutoclick" Style="{StaticResource NavItem}" Tag="&#xE962;" Content="Autoclicker" Checked="NavTab_Checked"/>
                                <RadioButton x:Name="TabNavMultiClick" Style="{StaticResource NavItem}" Tag="&#xE8FD;" Content="Múltiplos pontos" Checked="NavTab_Checked"/>
                                <RadioButton x:Name="TabNavMacro" Style="{StaticResource NavItem}" Tag="&#xE7C8;" Content="Macro" Checked="NavTab_Checked"/>

                                <TextBlock Text="Ferramentas" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="14,16,0,6"/>
                                <RadioButton x:Name="TabNavSafeZones" Style="{StaticResource NavItem}" Tag="&#xEA18;" Content="Zonas protegidas" Checked="NavTab_Checked"/>
                                <RadioButton x:Name="TabNavProfiles" Style="{StaticResource NavItem}" Tag="&#xE8F1;" Content="Perfis" Checked="NavTab_Checked"/>
                                <RadioButton x:Name="TabNavStatistics" Style="{StaticResource NavItem}" Tag="&#xE9D2;" Content="Estatísticas" Checked="NavTab_Checked"/>

                                <TextBlock Text="Sistema" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="14,16,0,6"/>
                                <RadioButton x:Name="TabNavHotkeys" Style="{StaticResource NavItem}" Tag="&#xE765;" Content="Atalhos" Checked="NavTab_Checked"/>
                                <RadioButton x:Name="TabNavSettings" Style="{StaticResource NavItem}" Tag="&#xE713;" Content="Configurações" Checked="NavTab_Checked"/>
                            </StackPanel>
                        </ScrollViewer>

                        <Button Grid.Row="1" x:Name="BtnPanicSidebar" Click="BtnPanic_Click"
                                Style="{StaticResource DangerButton}" HorizontalAlignment="Stretch" Height="36"
                                ToolTip="Interrompe cliques, macros e sequências imediatamente">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71A;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                <TextBlock Text="Parar tudo"/>
                                <TextBlock Text="  F12" Foreground="#B36466"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Content -->
                <Grid Grid.Column="1">

                    <!-- =================== PAINEL =================== -->
                    <ScrollViewer x:Name="ViewDashboard" Style="{StaticResource PageScroll}" Visibility="Visible">
                        <StackPanel MaxWidth="980">
                            <TextBlock Text="Painel" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Inicie o autoclicker e ajuste o essencial sem sair desta tela." Style="{StaticResource PageSubtitle}" Margin="0,4,0,20"/>

                            <!-- Status + main action -->
                            <Border Style="{StaticResource Card}" Padding="24,22">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="DashStatusDot" Width="10" Height="10" Fill="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock x:Name="TxtDashStatus" Text="Desligado" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtDashSubstatus" Text="Pronto para iniciar." Style="{StaticResource SectionHint}" Margin="20,6,0,0"/>
                                        <TextBlock x:Name="TxtDashShortcutHint" Text="F6 inicia ou para  ·  F12 interrompe tudo" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="20,10,0,0"/>
                                    </StackPanel>

                                    <Button Grid.Column="2" x:Name="BtnMainToggle" Click="BtnMainToggle_Click"
                                            Style="{StaticResource PrimaryButton}" Width="210" Height="46" FontSize="14"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="TxtMainActionIcon" Text="&#xE768;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,10,0"/>
                                            <TextBlock x:Name="TxtMainActionText" Text="Iniciar autoclick"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Metrics -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Tile}">
                                    <StackPanel>
                                        <TextBlock Text="Cliques por segundo" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="TxtCardCps" Text="10.0" Style="{StaticResource StatValue}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Tile}">
                                    <StackPanel>
                                        <TextBlock Text="Cliques nesta execução" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="TxtCardClicks" Text="0" Style="{StaticResource StatValue}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="4" Style="{StaticResource Tile}">
                                    <StackPanel>
                                        <TextBlock Text="Tempo ativo" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="TxtCardTime" Text="00:00:00" Style="{StaticResource StatValue}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Quick settings -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Configuração rápida" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="As opções completas ficam na aba Autoclicker." Style="{StaticResource SectionHint}" Margin="0,3,0,16"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Posição do clique" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox x:Name="CmbDashMode" SelectionChanged="CmbDashMode_SelectionChanged">
                                                <ComboBoxItem Content="Seguir cursor" IsSelected="True"/>
                                                <ComboBoxItem Content="Posição atual"/>
                                                <ComboBoxItem Content="Ponto fixo"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Botão do mouse" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox x:Name="CmbDashButton" SelectionChanged="CmbDashButton_SelectionChanged">
                                                <ComboBoxItem Content="Esquerdo" IsSelected="True"/>
                                                <ComboBoxItem Content="Direito"/>
                                                <ComboBoxItem Content="Meio"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Cliques por segundo" Style="{StaticResource FieldLabel}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Click="BtnCpsMinus_Click" Style="{StaticResource StepperButton}" Content="&#xE738;" ToolTip="Diminuir"/>
                                                <TextBox x:Name="TxtDashCpsInput" Grid.Column="1" Text="10" TextAlignment="Center" Margin="6,0" TextChanged="TxtDashCpsInput_TextChanged"/>
                                                <Button Grid.Column="2" Click="BtnCpsPlus_Click" Style="{StaticResource StepperButton}" Content="&#xE710;" ToolTip="Aumentar"/>
                                            </Grid>
                                            <TextBlock x:Name="TxtDashIntervalPreview" Text="Intervalo de 100 ms" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="6">
                                            <TextBlock Text="Repetição" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox x:Name="CmbDashRepeat" SelectionChanged="CmbDashRepeat_SelectionChanged">
                                                <ComboBoxItem Content="Até parar" IsSelected="True"/>
                                                <ComboBoxItem Content="100 cliques"/>
                                                <ComboBoxItem Content="Por 10 segundos"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <Border Style="{StaticResource Divider}"/>

                                    <TextBlock Text="Velocidades predefinidas" Style="{StaticResource FieldLabel}" Margin="0,0,0,10"/>
                                    <WrapPanel>
                                        <Button Click="QuickCps_Click" Tag="1" Content="1 CPS" Style="{StaticResource ChipButton}"/>
                                        <Button Click="QuickCps_Click" Tag="5" Content="5 CPS" Style="{StaticResource ChipButton}"/>
                                        <Button Click="QuickCps_Click" Tag="10" Content="10 CPS" Style="{StaticResource ChipButton}"/>
                                        <Button Click="QuickCps_Click" Tag="15" Content="15 CPS" Style="{StaticResource ChipButton}"/>
                                        <Button Click="QuickCps_Click" Tag="20" Content="20 CPS" Style="{StaticResource ChipButton}"/>
                                        <Button Click="QuickCps_Click" Tag="50" Content="50 CPS" Style="{StaticResource ChipButton}"/>
                                        <Button Click="QuickCps_Click" Tag="100" Content="100 CPS" Style="{StaticResource ChipButton}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- =================== AUTOCLICKER =================== -->
                    <ScrollViewer x:Name="ViewAutoclick" Style="{StaticResource PageScroll}" Visibility="Collapsed">
                        <StackPanel MaxWidth="980">
                            <TextBlock Text="Autoclicker" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Configuração detalhada de velocidade, posição e comportamento dos cliques." Style="{StaticResource PageSubtitle}" Margin="0,4,0,20"/>

                            <!-- Interval -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Intervalo entre cliques" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Defina o tempo entre os cliques ou informe diretamente quantos cliques por segundo deseja." Style="{StaticResource SectionHint}" Margin="0,3,0,16"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Horas" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="TxtHours" Text="0" TextAlignment="Center" TextChanged="IntervalInputs_TextChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Minutos" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="TxtMinutes" Text="0" TextAlignment="Center" TextChanged="IntervalInputs_TextChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Segundos" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="TxtSeconds" Text="0" TextAlignment="Center" TextChanged="IntervalInputs_TextChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="6">
                                            <TextBlock Text="Milissegundos" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="TxtMilliseconds" Text="100" TextAlignment="Center" TextChanged="IntervalInputs_TextChanged"/>
                                        </StackPanel>

                                        <Border Grid.Column="8" Width="1" Background="{StaticResource BorderBrush}" Margin="0,4,0,0"/>

                                        <StackPanel Grid.Column="10">
                                            <TextBlock Text="Cliques por segundo" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="TxtDirectCps" Text="10" TextAlignment="Center" TextChanged="TxtDirectCps_TextChanged"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Button & click type -->
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Botão do mouse" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
                                        <RadioButton x:Name="RbBtnLeft" GroupName="MouseBtn" Content="Esquerdo" IsChecked="True" Checked="MouseButton_Checked" Margin="0,0,0,10"/>
                                        <RadioButton x:Name="RbBtnRight" GroupName="MouseBtn" Content="Direito" Checked="MouseButton_Checked" Margin="0,0,0,10"/>
                                        <RadioButton x:Name="RbBtnMiddle" GroupName="MouseBtn" Content="Meio (roda)" Checked="MouseButton_Checked"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Tipo de clique" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
                                        <RadioButton x:Name="RbActionSingle" GroupName="ClickType" Content="Clique simples" IsChecked="True" Checked="ClickAction_Checked" Margin="0,0,0,10"/>
                                        <RadioButton x:Name="RbActionDouble" GroupName="ClickType" Content="Clique duplo" Checked="ClickAction_Checked" Margin="0,0,0,10"/>
                                        <RadioButton x:Name="RbActionHoldDown" GroupName="ClickType" Content="Apenas pressionar (manter segurado)" Checked="ClickAction_Checked" Margin="0,0,0,10"/>
                                        <RadioButton x:Name="RbActionHoldUp" GroupName="ClickType" Content="Apenas soltar" Checked="ClickAction_Checked"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Position -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Posição do clique" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>

                                    <RadioButton x:Name="RbPosFollow" GroupName="PosMode" IsChecked="True" Checked="PositionMode_Checked" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="Seguir o cursor"/>
                                            <TextBlock Text="Clica onde o ponteiro estiver a cada clique." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="RbPosCurrent" GroupName="PosMode" Checked="PositionMode_Checked" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="Posição atual"/>
                                            <TextBlock Text="Fixa o ponto onde o cursor estava ao iniciar." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="RbPosFixed" GroupName="PosMode" Checked="PositionMode_Checked">
                                        <StackPanel>
                                            <TextBlock Text="Ponto fixo na tela"/>
                                            <TextBlock Text="Sempre clica nas coordenadas definidas abaixo." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <Border x:Name="FixedCoordsBox" Background="{StaticResource InputBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="14,12" Margin="28,12,0,0" Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="X" Style="{StaticResource InlineLabel}" Margin="0,0,8,0"/>
                                            <TextBox x:Name="TxtFixedX" Grid.Column="1" Text="500" TextAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="Y" Style="{StaticResource InlineLabel}" Margin="16,0,8,0"/>
                                            <TextBox x:Name="TxtFixedY" Grid.Column="3" Text="500" TextAlignment="Center"/>
                                            <Button Grid.Column="5" Click="BtnPickFixedPoint_Click" Style="{StaticResource SecondaryButton}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE81D;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Selecionar na tela (F7)"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Repetition -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Repetição" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
                                    <RadioButton x:Name="RbRepeatInfinite" GroupName="Repeat" Content="Repetir até eu parar" IsChecked="True" Checked="RepeatMode_Checked" Margin="0,0,0,12"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="210"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <RadioButton x:Name="RbRepeatCount" GroupName="Repeat" Content="Repetir um número de vezes" Checked="RepeatMode_Checked" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtRepeatCount" Grid.Column="1" Text="100" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="cliques" Style="{StaticResource InlineLabel}" Margin="10,0,0,0"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="210"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <RadioButton x:Name="RbRepeatDuration" GroupName="Repeat" Content="Parar automaticamente após" Checked="RepeatMode_Checked" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtRepeatDuration" Grid.Column="1" Text="10" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="segundos" Style="{StaticResource InlineLabel}" Margin="10,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Burst + Randomization -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0">
                                    <StackPanel>
                                        <CheckBox x:Name="ChkBurstMode" Checked="ChkBurstMode_Changed" Unchecked="ChkBurstMode_Changed">
                                            <TextBlock Text="Modo rajada" FontWeight="SemiBold" FontSize="14"/>
                                        </CheckBox>
                                        <TextBlock Text="Envia grupos de cliques rápidos com uma pausa entre eles." Style="{StaticResource SectionHint}" Margin="28,4,0,16"/>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Cliques por rajada" Style="{StaticResource InlineLabel}"/>
                                            <TextBox x:Name="TxtBurstCount" Grid.Column="1" Text="5" TextAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Intervalo na rajada (ms)" Style="{StaticResource InlineLabel}"/>
                                            <TextBox x:Name="TxtBurstInterval" Grid.Column="1" Text="50" TextAlignment="Center"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Pausa entre rajadas (ms)" Style="{StaticResource InlineLabel}"/>
                                            <TextBox x:Name="TxtBurstCooldown" Grid.Column="1" Text="1000" TextAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                                    <StackPanel>
                                        <CheckBox x:Name="ChkRandomInterval" Checked="ChkRandomInterval_Changed" Unchecked="ChkRandomInterval_Changed">
                                            <TextBlock Text="Intervalo aleatório" FontWeight="SemiBold" FontSize="14"/>
                                        </CheckBox>
                                        <Grid Margin="28,10,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="De" Style="{StaticResource InlineLabel}" Margin="0,0,8,0"/>
                                            <TextBox x:Name="TxtMinRandomMs" Grid.Column="1" Text="80" TextAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="até" Style="{StaticResource InlineLabel}" Margin="10,0,8,0"/>
                                            <TextBox x:Name="TxtMaxRandomMs" Grid.Column="3" Text="150" TextAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="ms" Style="{StaticResource InlineLabel}" Margin="8,0,0,0"/>
                                        </Grid>

                                        <CheckBox x:Name="ChkRandomPos" Checked="ChkRandomPos_Changed" Unchecked="ChkRandomPos_Changed">
                                            <TextBlock Text="Variar posição" FontWeight="SemiBold" FontSize="14"/>
                                        </CheckBox>
                                        <Grid Margin="28,10,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Raio" Style="{StaticResource InlineLabel}" Margin="0,0,8,0"/>
                                            <TextBox x:Name="TxtRandomRadius" Grid.Column="1" Text="3" TextAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="pixels" Style="{StaticResource InlineLabel}" Margin="8,0,0,0"/>
                                        </Grid>

                                        <TextBlock Text="Atraso antes de começar" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="CmbStartDelay" SelectionChanged="CmbStartDelay_SelectionChanged">
                                            <ComboBoxItem Content="Sem atraso" Tag="0" IsSelected="True"/>
                                            <ComboBoxItem Content="1 segundo" Tag="1"/>
                                            <ComboBoxItem Content="3 segundos" Tag="3"/>
                                            <ComboBoxItem Content="5 segundos" Tag="5"/>
                                            <ComboBoxItem Content="10 segundos" Tag="10"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- =================== MÚLTIPLOS PONTOS =================== -->
                    <Grid x:Name="ViewMultiClick" Visibility="Collapsed" Margin="32,28,32,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="Múltiplos pontos" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Cadastre pontos na tela e o programa clica em cada um, em ordem. Dê dois cliques numa célula para editar X, Y ou espera." Style="{StaticResource PageSubtitle}" Margin="0,4,0,18"/>
                        </StackPanel>

                        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
                            <Button Click="BtnPickMultiPoint_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE81D;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Capturar ponto na tela"/>
                                </StackPanel>
                            </Button>
                            <Button Click="BtnAddMultiPoint_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" ToolTip="Adiciona a posição atual do cursor">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Adicionar posição do cursor"/>
                                </StackPanel>
                            </Button>
                            <Button Click="BtnDeleteMultiPoint_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Remover selecionado"/>
                                </StackPanel>
                            </Button>
                            <Button Click="BtnClearMultiPoints_Click" Style="{StaticResource GhostButton}" Content="Limpar lista" Margin="0,0,8,8"/>
                        </WrapPanel>

                        <DataGrid Grid.Row="2" x:Name="DgMultiPoints">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Index, Mode=OneWay}" Width="50" IsReadOnly="True"/>
                                <DataGridTextColumn Header="X" Binding="{Binding X}" Width="90" EditingElementStyle="{StaticResource GridEditTextBox}"/>
                                <DataGridTextColumn Header="Y" Binding="{Binding Y}" Width="90" EditingElementStyle="{StaticResource GridEditTextBox}"/>
                                <DataGridTextColumn Header="Espera (ms)" Binding="{Binding DelayMs}" Width="110" EditingElementStyle="{StaticResource GridEditTextBox}"/>
                                <DataGridTextColumn Header="Botão" Binding="{Binding ButtonName, Mode=OneWay}" Width="110" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Tipo" Binding="{Binding ActionName, Mode=OneWay}" Width="*" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Grid.Row="3" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Ciclos (0 = sem fim)" Style="{StaticResource InlineLabel}" Margin="0,0,10,0"/>
                            <TextBox x:Name="TxtMultiLoops" Grid.Column="1" Text="0" TextAlignment="Center"/>
                            <TextBlock x:Name="TxtMultiStatus" Grid.Column="2" Text="Nenhum ponto cadastrado." Style="{StaticResource InlineLabel}"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="16,0" TextTrimming="CharacterEllipsis"/>
                            <Button x:Name="BtnToggleMulti" Grid.Column="3" Click="BtnToggleMulti_Click" Style="{StaticResource PrimaryButton}" MinWidth="170" Height="38">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TxtMultiIcon" Text="&#xE768;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="TxtMultiText" Text="Iniciar sequência"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>

                    <!-- =================== MACRO =================== -->
                    <Grid x:Name="ViewMacro" Visibility="Collapsed" Margin="32,28,32,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="Macro" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Grava cliques, movimentos do mouse e teclas para repetir depois. Cliques feitos nesta janela não entram na gravação." Style="{StaticResource PageSubtitle}" Margin="0,4,0,18"/>
                        </StackPanel>

                        <!-- Recorder controls -->
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnRecordMacro" Click="BtnRecordMacro_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" MinWidth="100">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="9" Height="9" Fill="{StaticResource DangerBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Gravar"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnStopRecordMacro" Click="BtnStopRecordMacro_Click" Style="{StaticResource SecondaryButton}" IsEnabled="False" Margin="0,0,8,0" MinWidth="100">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE71A;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,8,0"/>
                                            <TextBlock Text="Parar"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnPlayMacro" Click="BtnPlayMacro_Click" Style="{StaticResource PrimaryButton}" MinWidth="120">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,8,0"/>
                                            <TextBlock Text="Reproduzir"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
                                    <Ellipse x:Name="MacroStatusDot" Width="8" Height="8" Fill="{StaticResource TextMutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtMacroStatus" Text="Pronto" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Click="BtnSaveMacro_Click" Style="{StaticResource GhostButton}" ToolTip="Salvar macro em arquivo" Padding="10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                            <TextBlock Text="Salvar"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="BtnLoadMacro_Click" Style="{StaticResource GhostButton}" ToolTip="Abrir macro salva" Padding="10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                            <TextBlock Text="Abrir"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnClearMacro" Click="BtnClearMacro_Click" Style="{StaticResource GhostButton}" ToolTip="Apagar todas as ações" Padding="10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                            <TextBlock Text="Limpar"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Options -->
                        <Grid Grid.Row="2" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Velocidade" Style="{StaticResource InlineLabel}" Margin="0,0,10,0"/>
                            <ComboBox x:Name="CmbMacroSpeed" Grid.Column="1" SelectionChanged="CmbMacroSpeed_SelectionChanged">
                                <ComboBoxItem Content="0,5x" Tag="0.5"/>
                                <ComboBoxItem Content="1x" Tag="1.0" IsSelected="True"/>
                                <ComboBoxItem Content="1,5x" Tag="1.5"/>
                                <ComboBoxItem Content="2x" Tag="2.0"/>
                                <ComboBoxItem Content="3x" Tag="3.0"/>
                            </ComboBox>
                            <TextBlock Grid.Column="3" Text="Repetições" Style="{StaticResource InlineLabel}" Margin="0,0,10,0"/>
                            <ComboBox x:Name="CmbMacroLoops" Grid.Column="4">
                                <ComboBoxItem Content="1 vez" Tag="1" IsSelected="True"/>
                                <ComboBoxItem Content="5 vezes" Tag="5"/>
                                <ComboBoxItem Content="10 vezes" Tag="10"/>
                                <ComboBoxItem Content="100 vezes" Tag="100"/>
                                <ComboBoxItem Content="Sem fim" Tag="0"/>
                            </ComboBox>
                            <CheckBox x:Name="ChkMacroRecordMoves" Grid.Column="6" Content="Gravar movimento do mouse" IsChecked="True" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ChkMacroRecordKeyboard" Grid.Column="8" Content="Gravar teclado" IsChecked="True" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Actions list -->
                        <DataGrid Grid.Row="3" x:Name="DgMacroActions" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding SequenceNumber, Mode=OneWay}" Width="60"/>
                                <DataGridTextColumn Header="Ação" Binding="{Binding Description, Mode=OneWay}" Width="2*"/>
                                <DataGridTextColumn Header="Posição / tecla" Binding="{Binding Detail, Mode=OneWay}" Width="1.4*"/>
                                <DataGridTextColumn Header="Espera (ms)" Binding="{Binding DelayMs, Mode=OneWay}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Grid.Row="4" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtMacroSummary" Text="Nenhuma ação gravada." FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TxtMacroHint" Grid.Column="1" Text="F8 reproduz  ·  F9 para" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="16,0,0,0"/>
                        </Grid>
                    </Grid>

                    <!-- =================== ZONAS PROTEGIDAS =================== -->
                    <ScrollViewer x:Name="ViewSafeZones" Style="{StaticResource PageScroll}" Visibility="Collapsed">
                        <StackPanel MaxWidth="980">
                            <TextBlock Text="Zonas protegidas" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Áreas da tela onde nenhum clique automático será feito, como o botão de fechar ou a barra de tarefas." Style="{StaticResource PageSubtitle}" Margin="0,4,0,20"/>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Zonas cadastradas" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Click="BtnAddSafeZone_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Desenhar zona"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Click="BtnDeleteSafeZone_Click" Style="{StaticResource SecondaryButton}" Content="Remover"/>
                                        </StackPanel>
                                    </Grid>

                                    <DataGrid x:Name="DgSafeZones" Height="180">
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn Header="Ativa" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="64"/>
                                            <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="*" EditingElementStyle="{StaticResource GridEditTextBox}"/>
                                            <DataGridTextColumn Header="X" Binding="{Binding X, Mode=OneWay}" Width="70" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Y" Binding="{Binding Y, Mode=OneWay}" Width="70" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Largura" Binding="{Binding Width, Mode=OneWay}" Width="80" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Altura" Binding="{Binding Height, Mode=OneWay}" Width="80" IsReadOnly="True"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Restringir a uma janela" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Os cliques e macros só acontecem enquanto a janela escolhida estiver em foco. Ao trocar de janela, tudo pausa automaticamente." Style="{StaticResource SectionHint}" Margin="0,3,0,14"/>
                                    <CheckBox x:Name="ChkRestrictWindow" Content="Ativar restrição por janela" Checked="ChkRestrictWindow_Changed" Unchecked="ChkRestrictWindow_Changed" Margin="0,0,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="CmbTargetWindows" SelectionChanged="CmbTargetWindows_SelectionChanged"/>
                                        <Button Grid.Column="1" Click="BtnRefreshWindows_Click" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" ToolTip="Atualizar lista de janelas">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                                <TextBlock Text="Atualizar"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Pausa automática" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
                                    <CheckBox x:Name="ChkPauseOnWindowChange" Content="Pausar ao trocar de aplicativo" Margin="0,0,0,12"/>
                                    <CheckBox x:Name="ChkPauseOnLock" Content="Pausar quando o Windows for bloqueado" IsChecked="True" Margin="0,0,0,12"/>
                                    <CheckBox x:Name="ChkStopOnSafeZone" Content="Parar o autoclick se o cursor entrar em uma zona protegida"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- =================== PERFIS =================== -->
                    <Grid x:Name="ViewProfiles" Visibility="Collapsed" Margin="32,28,32,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="Perfis" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Guarde configurações diferentes para cada jogo ou tarefa e alterne entre elas com um clique." Style="{StaticResource PageSubtitle}" Margin="0,4,0,18"/>
                        </StackPanel>

                        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
                            <Button Click="BtnNewProfile_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Novo perfil"/>
                                </StackPanel>
                            </Button>
                            <Button Click="BtnDuplicateProfile_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Duplicar"/>
                                </StackPanel>
                            </Button>
                            <Button Click="BtnDeleteProfile_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,20,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Excluir"/>
                                </StackPanel>
                            </Button>
                            <Button Click="BtnImportProfile_Click" Style="{StaticResource GhostButton}" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Importar"/>
                                </StackPanel>
                            </Button>
                            <Button Click="BtnExportProfile_Click" Style="{StaticResource GhostButton}" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE898;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Exportar"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <ListBox Grid.Row="2" x:Name="LstProfiles" SelectionChanged="LstProfiles_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid Grid.Row="3" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Perfil ativo:" Style="{StaticResource InlineLabel}" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtActiveProfileName" Grid.Column="1" Text="—" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="2" Click="BtnApplyAndSaveProfile_Click" Style="{StaticResource PrimaryButton}" Margin="16,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Salvar configuração atual no perfil"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>

                    <!-- =================== ESTATÍSTICAS =================== -->
                    <ScrollViewer x:Name="ViewStatistics" Style="{StaticResource PageScroll}" Visibility="Collapsed">
                        <StackPanel MaxWidth="980">
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Estatísticas" Style="{StaticResource PageTitle}"/>
                                    <TextBlock Text="Histórico de uso do aplicativo." Style="{StaticResource PageSubtitle}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Click="BtnResetStats_Click" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                        <TextBlock Text="Zerar estatísticas"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Tile}">
                                    <StackPanel>
                                        <TextBlock Text="Cliques na sessão" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="TxtStatsSessionClicks" Text="0" Style="{StaticResource StatValue}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Tile}">
                                    <StackPanel>
                                        <TextBlock Text="Cliques no total" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="TxtStatsTotalClicks" Text="0" Style="{StaticResource StatValue}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="4" Style="{StaticResource Tile}">
                                    <StackPanel>
                                        <TextBlock Text="Tempo total ativo" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="TxtStatsTotalTime" Text="00:00:00" Style="{StaticResource StatValue}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Tile}">
                                    <StackPanel>
                                        <TextBlock Text="CPS médio da sessão" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="TxtStatsAvgCps" Text="0.0" Style="{StaticResource StatValue}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Tile}">
                                    <StackPanel>
                                        <TextBlock Text="Maior CPS registrado" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="TxtStatsPeakCps" Text="0.0" Style="{StaticResource StatValue}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="4" Style="{StaticResource Tile}">
                                    <StackPanel>
                                        <TextBlock Text="Macros executadas" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="TxtStatsMacros" Text="0" Style="{StaticResource StatValue}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- =================== ATALHOS =================== -->
                    <ScrollViewer x:Name="ViewHotkeys" Style="{StaticResource PageScroll}" Visibility="Collapsed">
                        <StackPanel MaxWidth="980">
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Atalhos" Style="{StaticResource PageTitle}"/>
                                    <TextBlock Text="Funcionam em qualquer programa, mesmo com o Gabriel Autoclick minimizado." Style="{StaticResource PageSubtitle}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Click="BtnRestoreDefaultHotkeys_Click" Style="{StaticResource SecondaryButton}" Content="Restaurar padrões" VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </Grid>

                            <Border Style="{StaticResource Card}" Padding="0">
                                <StackPanel>
                                    <!-- Row -->
                                    <Grid Margin="20,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Iniciar / parar autoclick" FontWeight="SemiBold"/>
                                            <TextBlock Text="Liga ou desliga o autoclicker." Style="{StaticResource SectionHint}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource KeyCap}" VerticalAlignment="Center" Margin="16,0,12,0">
                                            <TextBlock x:Name="TxtKeyToggleAutoclick" Text="F6" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Button Grid.Column="2" Click="BtnChangeHotkey_Click" Tag="ToggleAutoclick" Content="Alterar" Style="{StaticResource SecondaryButton}"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource BorderBrush}"/>

                                    <Grid Margin="20,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Selecionar posição" FontWeight="SemiBold"/>
                                            <TextBlock Text="Escolhe um ponto fixo na tela para os cliques." Style="{StaticResource SectionHint}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource KeyCap}" VerticalAlignment="Center" Margin="16,0,12,0">
                                            <TextBlock x:Name="TxtKeySelectPosition" Text="F7" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Button Grid.Column="2" Click="BtnChangeHotkey_Click" Tag="SelectPosition" Content="Alterar" Style="{StaticResource SecondaryButton}"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource BorderBrush}"/>

                                    <Grid Margin="20,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Reproduzir macro" FontWeight="SemiBold"/>
                                            <TextBlock Text="Executa a macro gravada. Durante a gravação, finaliza a gravação." Style="{StaticResource SectionHint}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource KeyCap}" VerticalAlignment="Center" Margin="16,0,12,0">
                                            <TextBlock x:Name="TxtKeyStartMacro" Text="F8" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Button Grid.Column="2" Click="BtnChangeHotkey_Click" Tag="StartMacro" Content="Alterar" Style="{StaticResource SecondaryButton}"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource BorderBrush}"/>

                                    <Grid Margin="20,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Parar macro" FontWeight="SemiBold"/>
                                            <TextBlock Text="Interrompe a reprodução ou a gravação da macro." Style="{StaticResource SectionHint}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource KeyCap}" VerticalAlignment="Center" Margin="16,0,12,0">
                                            <TextBlock x:Name="TxtKeyStopMacro" Text="F9" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Button Grid.Column="2" Click="BtnChangeHotkey_Click" Tag="StopMacro" Content="Alterar" Style="{StaticResource SecondaryButton}"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource BorderBrush}"/>

                                    <Grid Margin="20,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Parar tudo" FontWeight="SemiBold"/>
                                            <TextBlock Text="Interrompe imediatamente cliques, macros e sequências. Fixo por segurança." Style="{StaticResource SectionHint}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource KeyCap}" VerticalAlignment="Center" Margin="16,0,12,0">
                                            <TextBlock Text="F12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="&#xE72E;" Style="{StaticResource Icon}" Foreground="{StaticResource TextMutedBrush}" Width="78" TextAlignment="Center" ToolTip="Atalho fixo"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- =================== CONFIGURAÇÕES =================== -->
                    <ScrollViewer x:Name="ViewSettings" Style="{StaticResource PageScroll}" Visibility="Collapsed">
                        <StackPanel MaxWidth="980">
                            <TextBlock Text="Configurações" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Preferências gerais do aplicativo." Style="{StaticResource PageSubtitle}" Margin="0,4,0,20"/>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Geral" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
                                    <CheckBox x:Name="ChkStartWithWindows" Content="Iniciar junto com o Windows" Checked="Setting_Changed" Unchecked="Setting_Changed" Margin="0,0,0,12"/>
                                    <CheckBox x:Name="ChkMinimizeToTray" Content="Ao fechar ou minimizar, manter na bandeja do sistema" IsChecked="True" Checked="Setting_Changed" Unchecked="Setting_Changed" Margin="0,0,0,12"/>
                                    <CheckBox x:Name="ChkAlwaysOnTop" Content="Manter a janela sempre por cima" Checked="ChkAlwaysOnTop_Changed" Unchecked="ChkAlwaysOnTop_Changed" Margin="0,0,0,12"/>
                                    <CheckBox x:Name="ChkAutoSaveSettings" Content="Salvar configurações automaticamente" IsChecked="True" Checked="Setting_Changed" Unchecked="Setting_Changed" Margin="0,0,0,12"/>
                                    <CheckBox x:Name="ChkShowNotifications" Content="Mostrar notificações do Windows" IsChecked="True" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Sons" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Tons suaves e discretos para confirmar quando algo começa ou termina." Style="{StaticResource SectionHint}" Margin="0,3,0,14"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="ChkSoundStart" Content="Tocar som ao iniciar cliques ou macros" IsChecked="True" Checked="Setting_Changed" Unchecked="Setting_Changed" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Click="BtnPreviewStartSound_Click" Style="{StaticResource GhostButton}" Padding="10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,8,0"/>
                                                <TextBlock Text="Ouvir"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="ChkSoundStop" Content="Tocar som ao parar" IsChecked="True" Checked="Setting_Changed" Unchecked="Setting_Changed" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Click="BtnPreviewStopSound_Click" Style="{StaticResource GhostButton}" Padding="10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,8,0"/>
                                                <TextBlock Text="Ouvir"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Aparência" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
                                    <CheckBox x:Name="ChkWallpaper" Content="Mostrar foto de fundo" IsChecked="True"
                                              Checked="ChkWallpaper_Changed" Unchecked="ChkWallpaper_Changed" Margin="0,0,0,14"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Visibilidade da foto" Style="{StaticResource InlineLabel}" Margin="28,0,12,0"/>
                                        <ComboBox x:Name="CmbWallpaperIntensity" Grid.Column="1" SelectionChanged="CmbWallpaperIntensity_SelectionChanged">
                                            <ComboBoxItem Content="Discreta" Tag="0.88"/>
                                            <ComboBoxItem Content="Média" Tag="0.80" IsSelected="True"/>
                                            <ComboBoxItem Content="Forte" Tag="0.65"/>
                                            <ComboBoxItem Content="Bem visível" Tag="0.50"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="TxtVersion" Text="Gabriel Autoclick" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="2,4,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ======================================================== -->
            <!-- STATUS BAR                                               -->
            <!-- ======================================================== -->
            <Border Grid.Row="2" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="TopStatusDot" Width="7" Height="7" Fill="{StaticResource TextMutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtTopStatus" Text="Desligado" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="CPS" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TxtTopCps" Text="0.0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" MinWidth="34"/>
                        <TextBlock Text="Cliques" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="14,0,6,0"/>
                        <TextBlock x:Name="TxtTopClicks" Text="0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" MinWidth="40"/>
                        <TextBlock Text="Tempo" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="14,0,6,0"/>
                        <TextBlock x:Name="TxtTopTimer" Text="00:00:00" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ======================================================== -->
            <!-- MODALS                                                   -->
            <!-- ======================================================== -->
            <Grid x:Name="ModalHost" Grid.RowSpan="3" Visibility="Collapsed" Background="#B3000000">
                <!-- Hotkey capture -->
                <Border x:Name="ModalCaptureHotkey" Visibility="Collapsed" Width="420" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="10" Padding="24"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Definir atalho" Style="{StaticResource SectionTitle}" FontSize="16"/>
                        <TextBlock x:Name="TxtCaptureActionName" Text="Iniciar / parar autoclick" Style="{StaticResource SectionHint}" Margin="0,4,0,18"/>
                        <Border Background="{StaticResource InputBgBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="16,22">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Pressione a tecla ou combinação desejada" HorizontalAlignment="Center"/>
                                <TextBlock Text="Exemplos: F3, Ctrl + F6, Alt + Q" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtCaptureCurrentHotkey" Text="Atual: F6" Style="{StaticResource InlineLabel}" FontSize="12"/>
                            <Button Grid.Column="1" Click="BtnCancelCapture_Click" Content="Cancelar" Style="{StaticResource SecondaryButton}" MinWidth="100"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Conflict -->
                <Border x:Name="ModalConflict" Visibility="Collapsed" Width="420" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="10" Padding="24"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource WarningBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="Atalho em uso" Style="{StaticResource SectionTitle}" FontSize="16"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtConflictMessage" Text="Esse atalho já está sendo usado por outro comando." TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,20"/>
                        <Button Click="BtnCloseConflictModal_Click" Content="Entendi" Style="{StaticResource PrimaryButton}" MinWidth="100" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>

                <!-- Restore confirm -->
                <Border x:Name="ModalRestoreConfirm" Visibility="Collapsed" Width="440" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="10" Padding="24"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Restaurar atalhos padrão?" Style="{StaticResource SectionTitle}" FontSize="16"/>
                        <TextBlock Text="Todos os atalhos voltarão para a configuração original:" Style="{StaticResource SectionHint}" Margin="0,6,0,14"/>
                        <Border Background="{StaticResource InputBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Iniciar / parar autoclick" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="F6" FontWeight="SemiBold" Margin="0,2"/>
                                <TextBlock Grid.Row="1" Text="Selecionar posição" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="F7" FontWeight="SemiBold" Margin="0,2"/>
                                <TextBlock Grid.Row="2" Text="Reproduzir macro" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="F8" FontWeight="SemiBold" Margin="0,2"/>
                                <TextBlock Grid.Row="3" Text="Parar macro" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="F9" FontWeight="SemiBold" Margin="0,2"/>
                                <TextBlock Grid.Row="4" Text="Parar tudo (fixo)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="F12" FontWeight="SemiBold" Margin="0,2"/>
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Click="BtnCancelRestoreHotkeys_Click" Content="Cancelar" Style="{StaticResource SecondaryButton}" MinWidth="100" Margin="0,0,8,0"/>
                            <Button Click="BtnConfirmRestoreHotkeys_Click" Content="Restaurar" Style="{StaticResource PrimaryButton}" MinWidth="100"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
